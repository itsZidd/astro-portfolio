---
import "../styles/global.css";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import { getLangFromUrl, getPathWithoutLang, useTranslations, getLocalizedPath } from "../i18n/utils";
import { languages } from "../i18n/config";

interface Props {
    title: string;
    description?: string;
}
const {
    title,
    description = "Software developer and geographer — apps, geospatial analysis, and machine learning projects.",
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const pathWithoutLang = getPathWithoutLang(Astro.url);
const t = useTranslations(lang);

const nav = [
    { label: t("nav.work"), href: "/#work" },
    { label: t("nav.stats"), href: "/stats" },
    { label: t("nav.about"), href: "/#about" },
    { label: t("nav.contact"), href: "/#contact" },
];

const localeCodes = Object.keys(languages) as (keyof typeof languages)[];
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="description" content={description} />
        <title>{title}</title>

        {
            localeCodes.map((code) => (
                <link
                    rel="alternate"
                    hreflang={code}
                    href={new URL(getLocalizedPath(code, pathWithoutLang), Astro.site ?? Astro.url.origin)}
                />
            ))
        }
        <link
            rel="alternate"
            hreflang="x-default"
            href={new URL(getLocalizedPath("en", pathWithoutLang), Astro.site ?? Astro.url.origin)}
        />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Big+Shoulders:wght@600;700;800&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
            rel="stylesheet"
        />
    </head>
    <body>
        <header class="site-header">
            <div class="wrap site-header__inner">
                <a href={getLocalizedPath(lang, "/")} class="site-header__mark">MZM</a>
                <div class="site-header__right">
                    <nav class="site-header__nav">
                        {nav.map((item) => <a href={getLocalizedPath(lang, item.href)}>{item.label}</a>)}
                    </nav>
                    <LanguageSwitcher lang={lang} path={pathWithoutLang} />
                </div>
            </div>
        </header>
        <main>
            <slot />
        </main>
        <footer class="site-footer">
            <div class="wrap site-footer__inner">
                <span class="eyebrow">{t("footer.built")}</span>
                <span class="eyebrow" id="coord">-7.9666, 112.5183</span>
            </div>
        </footer>
        <style>
            .site-header {
                position: sticky;
                top: 0;
                z-index: 20;
                background: color-mix(in srgb, var(--bg) 85%, transparent);
                backdrop-filter: blur(8px);
                border-bottom: 0.5px solid var(--border-soft);
            }
            .site-header__inner {
                display: flex;
                align-items: center;
                justify-content: space-between;
                height: 60px;
            }
            .site-header__mark {
                font-family: var(--font-mono);
                font-size: 13px;
                letter-spacing: 0.08em;
                color: var(--text);
                border: 0.5px solid var(--border);
                border-radius: var(--radius-sm);
                padding: 4px 8px;
            }
            .site-header__right {
                display: flex;
                align-items: center;
                gap: 24px;
            }
            .site-header__nav {
                display: flex;
                gap: 28px;
            }
            .site-header__nav a {
                font-family: var(--font-mono);
                font-size: 13px;
                color: var(--text-secondary);
                transition: color 0.15s ease;
            }
            .site-header__nav a:hover {
                color: var(--accent);
            }
            .site-footer {
                border-top: 0.5px solid var(--border-soft);
                margin-top: 96px;
            }
            .site-footer__inner {
                display: flex;
                justify-content: space-between;
                padding-block: 28px;
            }

            @media (max-width: 560px) {
                .site-header__right {
                    gap: 14px;
                }
                .site-header__nav {
                    gap: 16px;
                }
            }
        </style>
    </body>
</html>
