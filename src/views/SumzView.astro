---
import CaseStudyLayout from "../components/CaseStudyLayout.astro";
import { useTranslations, getLocalizedPath } from "../i18n/utils";
import type { Lang } from "../i18n/config";
import { sumzContent, sumzScreenshotOrder } from "../content/sumz.ts";

interface Props {
    lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const c = sumzContent[lang];

const screenshots = sumzScreenshotOrder.map((key) => ({
    src: `/work/sumz/${key}.png`,
    alt: c.screenshotAlts[key],
}));
---

<CaseStudyLayout
    lang={lang}
    pageTitle="Sumz — AI Article Summarizer — M. Zidan Malik"
    displayTitle="Sumz — AI Article Summarizer"
    eyebrow={c.eyebrow}
    pitch={c.pitch}
    links={[
        {
            href: "https://sumz-pearl.vercel.app/",
            label: t("case.tryLive"),
            icon: "globe",
            variant: "primary",
            external: true,
        },
        {
            href: "https://github.com/itsZidd/Sumz",
            label: t("case.viewGithub"),
            icon: "square-arrow-out-up-right",
            variant: "secondary",
            external: true,
        },
        {
            href: `${getLocalizedPath(lang, "/feedback")}?project=sumz`,
            label: t("case.giveFeedback"),
            icon: "message-square",
            variant: "secondary",
        },
    ]}
    screenshots={screenshots}
    featureGroups={c.featureGroups}
    stackGroups={c.stackGroups}
    studyTitle={c.studyTitle}
    story={c.story}
    notes={c.notes}
/>
