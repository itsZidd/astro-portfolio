---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import TechIcon from "../components/TechIcon.astro";
import { useTranslations, getLocalizedPath } from "../i18n/utils";
import type { Lang } from "../i18n/config";
import { prayerTimeContent, screenshotOrder } from "../content/prayerTime.ts";

interface Props {
    lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const c = prayerTimeContent[lang];

const screenshots = screenshotOrder.map((key) => ({
    src: `/work/prayer-time/${key}.png`,
    alt: c.screenshotAlts[key],
}));

/**
 * Escapes HTML, then turns `backtick` segments into <code> spans.
 * Content is our own dictionary text (not user input), but escaping
 * first keeps this safe regardless.
 */
function inlineCode(raw: string): string {
    const escaped = raw
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;");
    return escaped.replace(/`([^`]+)`/g, "<code>$1</code>");
}
---

<Layout title="Prayer Time — M. Zidan Malik">
    <article class="case">
        <div class="wrap">
            <a href={getLocalizedPath(lang, "/#work")} class="case__back">
                <Icon name="arrow-left" size={14} />
                {t("case.back")}
            </a>

            <p class="eyebrow">{t("case.eyebrow")}</p>
            <h1 class="h-display case__title">Prayer Time</h1>
            <p class="case__pitch">{c.pitch}</p>

            <div class="case__links">
                <a
                    class="case__btn case__btn--primary"
                    href="https://github.com/itsZidd/expo-prayer-time/releases/download/1.0.0/application-375dc22a-becb-4ab2-8312-4a8f3002da15.apk"
                >
                    <Icon name="download" size={15} />
                    {t("case.downloadApk")}
                </a>
                <a
                    class="case__btn"
                    href="https://github.com/itsZidd/expo-prayer-time"
                    target="_blank"
                    rel="noreferrer"
                >
                    <Icon name="square-arrow-out-up-right" size={15} />
                    {t("case.viewGithub")}
                </a>
            </div>
        </div>

        <section class="wrap case__section">
            <h2 class="section-title">{t("case.screens")}</h2>
            <div class="shot-carousel">
                <div class="shot-nav-wrap shot-nav-wrap--prev">
                    <button
                        class="shot-nav"
                        aria-label={t("case.scrollLeft")}
                        type="button"
                    >
                        <Icon name="chevron-left" size={24} strokeWidth={2.25} />
                    </button>
                </div>
                <div class="shot-grid">
                    {
                        screenshots.map((s) => (
                            <div class="shot">
                                <img src={s.src} alt={s.alt} loading="lazy" />
                            </div>
                        ))
                    }
                </div>
                <div class="shot-nav-wrap shot-nav-wrap--next">
                    <button
                        class="shot-nav"
                        aria-label={t("case.scrollRight")}
                        type="button"
                    >
                        <Icon name="chevron-right" size={24} strokeWidth={2.25} />
                    </button>
                </div>
            </div>
        </section>

        <section class="wrap case__section">
            <h2 class="section-title">{t("case.whatsBuilt")}</h2>
            <div class="stack-grid">
                {
                    c.featureGroups.map((g) => (
                        <div class="stack-group">
                            <p class="eyebrow">{g.label}</p>
                            <ul>
                                {g.items.map((item) => (
                                    <li>{item}</li>
                                ))}
                            </ul>
                        </div>
                    ))
                }
            </div>
        </section>

        <section class="wrap case__section">
            <h2 class="section-title">{t("case.techStack")}</h2>
            <div class="stack-grid">
                {
                    c.stackGroups.map((g) => (
                        <div class="stack-group">
                            <p class="eyebrow">{g.label}</p>
                            <ul>
                                {g.items.map((item) => (
                                    <li>
                                        <span class="tech-slot">
                                            <TechIcon name={item} size={14} />
                                        </span>
                                        <span>{item}</span>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))
                }
            </div>
        </section>

        <section class="wrap case__section">
            <h2 class="section-title">{c.studyTitle}</h2>

            <div class="story">
                {
                    c.story.map((block) => (
                        <div class="story__block">
                            <p class="story__label">{block.label}</p>
                            <p set:html={inlineCode(block.body)} />
                        </div>
                    ))
                }
            </div>
        </section>

        <section class="wrap case__section case__section--last">
            <h2 class="section-title">{t("case.limitations")}</h2>
            <div class="notes">
                {
                    c.notes.map((n) => (
                        <div class="notes__item">
                            <p class="notes__title">{n.title}</p>
                            <p set:html={inlineCode(n.body)} />
                        </div>
                    ))
                }
            </div>
        </section>
    </article>

    <style>
        .case__back {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-top: 32px;
            font-family: var(--font-mono);
            font-size: 13px;
            color: var(--text-secondary);
            padding: 7px 12px 7px 10px;
            border: 0.5px solid var(--border);
            border-radius: var(--radius-sm);
            transition:
                border-color 0.15s ease,
                color 0.15s ease,
                background 0.15s ease;
        }
        .case__back:hover {
            color: var(--accent);
            border-color: var(--accent);
            background: var(--surface);
        }

        .case__title {
            font-size: clamp(2.6rem, 6vw, 4.2rem);
            margin: 10px 0 0;
        }
        .case__pitch {
            max-width: 68ch;
            color: var(--text-secondary);
            font-size: 16px;
            margin-top: 20px;
        }
        .case__links {
            margin-top: 20px;
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }
        .case__btn {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            font-family: var(--font-mono);
            font-size: 13px;
            padding: 9px 16px;
            border-radius: var(--radius-sm);
            border: 0.5px solid var(--border);
            color: var(--text);
            transition:
                border-color 0.15s ease,
                color 0.15s ease;
        }
        .case__btn--primary {
            background: var(--green-700);
            border-color: var(--green-500);
            color: var(--text);
        }
        .case__btn--primary:hover {
            background: var(--green-500);
        }
        .case__btn:not(.case__btn--primary):hover {
            border-color: var(--accent);
            color: var(--accent);
        }

        .case__section {
            padding-top: 64px;
        }
        .case__section--last {
            padding-bottom: 80px;
        }

        .section-title {
            font-family: var(--font-display);
            text-transform: uppercase;
            letter-spacing: 0.02em;
            font-size: 1.4rem;
            color: var(--text);
            margin: 0 0 28px;
        }

        .shot-carousel {
            position: relative;
        }
        .shot-nav-wrap {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            margin-top: -4px;
            z-index: 2;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
        }
        .shot-nav-wrap--prev {
            left: -24px;
        }
        .shot-nav-wrap--next {
            right: -24px;
        }
        .shot-nav {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            border: 0.5px solid var(--border);
            background: var(--surface-2);
            color: var(--text);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.4);
            transition:
                background 0.15s ease,
                border-color 0.15s ease,
                color 0.15s ease,
                transform 0.15s ease;
        }
        .shot-nav:hover {
            background: var(--surface);
            border-color: var(--accent);
            color: var(--accent);
            transform: scale(1.06);
        }
        .shot-nav-wrap[data-disabled="true"] {
            opacity: 0;
            pointer-events: none;
        }
        @media (hover: none) {
            .shot-nav-wrap {
                display: none;
            }
        }

        .shot-grid {
            display: flex;
            gap: 14px;
            overflow-x: auto;
            overflow-y: hidden;
            padding-bottom: 8px;
            scroll-snap-type: x mandatory;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: thin;
            scrollbar-color: var(--border) transparent;
        }
        .shot-grid::-webkit-scrollbar {
            height: 8px;
        }
        .shot-grid::-webkit-scrollbar-track {
            background: transparent;
        }
        .shot-grid::-webkit-scrollbar-thumb {
            background: var(--border);
            border-radius: 8px;
        }
        .shot {
            flex: 0 0 auto;
            scroll-snap-align: start;
            width: 280px;
            border: 0.5px solid var(--border);
            border-radius: var(--radius);
            overflow: hidden;
            background: var(--surface);
        }
        .shot img {
            width: 100%;
            height: auto;
            display: block;
        }

        .stack-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 24px;
        }
        .stack-group ul {
            list-style: none;
            margin: 10px 0 0;
            padding: 0;
        }
        .stack-group li {
            display: flex;
            align-items: center;
            gap: 9px;
            font-size: 13.5px;
            color: var(--text-secondary);
            line-height: 1.5;
            padding: 7px 0;
            border-bottom: 0.5px solid var(--border-soft);
        }
        .stack-group .tech-slot {
            display: inline-flex;
            width: 14px;
            flex-shrink: 0;
        }
        .stack-group li :global(svg) {
            flex-shrink: 0;
            color: var(--text-faint);
        }

        .story {
            display: grid;
            gap: 24px;
        }
        .story__block {
            background: var(--surface);
            border: 0.5px solid var(--border);
            border-radius: var(--radius);
            padding: 20px 22px;
        }
        .story__label {
            font-family: var(--font-mono);
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--accent-strong);
            margin: 0 0 10px;
        }
        .story__block p:last-child {
            margin: 0;
        }
        .story__block p {
            color: var(--text-secondary);
            font-size: 14.5px;
            line-height: 1.65;
        }
        .story__block :global(code) {
            font-family: var(--font-mono);
            font-size: 0.9em;
            color: var(--green-100);
            background: var(--surface-2);
            padding: 1px 5px;
            border-radius: 4px;
        }

        .notes {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
        }
        .notes__title {
            font-weight: 600;
            font-size: 14.5px;
            color: var(--text);
            margin: 0 0 8px;
        }
        .notes__item p:last-child {
            color: var(--text-secondary);
            font-size: 14px;
            line-height: 1.6;
            margin: 0;
        }
        .notes__item :global(code) {
            font-family: var(--font-mono);
            font-size: 0.9em;
            color: var(--green-100);
            background: var(--surface-2);
            padding: 1px 5px;
            border-radius: 4px;
        }
    </style>

    <script>
        function initShotCarousels() {
            document
                .querySelectorAll<HTMLElement>(".shot-carousel")
                .forEach((carousel) => {
                    const track =
                        carousel.querySelector<HTMLElement>(".shot-grid");
                    const prevWrap = carousel.querySelector<HTMLElement>(
                        ".shot-nav-wrap--prev",
                    );
                    const nextWrap = carousel.querySelector<HTMLElement>(
                        ".shot-nav-wrap--next",
                    );
                    const prevBtn =
                        prevWrap?.querySelector<HTMLButtonElement>(".shot-nav");
                    const nextBtn =
                        nextWrap?.querySelector<HTMLButtonElement>(".shot-nav");
                    if (
                        !track ||
                        !prevWrap ||
                        !nextWrap ||
                        !prevBtn ||
                        !nextBtn
                    )
                        return;

                    const scrollByAmount = () =>
                        Math.round(track.clientWidth * 0.8);

                    prevBtn.addEventListener("click", () => {
                        track.scrollBy({
                            left: -scrollByAmount(),
                            behavior: "smooth",
                        });
                    });
                    nextBtn.addEventListener("click", () => {
                        track.scrollBy({
                            left: scrollByAmount(),
                            behavior: "smooth",
                        });
                    });

                    const updateButtons = () => {
                        const maxScroll =
                            track.scrollWidth - track.clientWidth - 2;
                        prevWrap.setAttribute(
                            "data-disabled",
                            String(track.scrollLeft <= 0),
                        );
                        nextWrap.setAttribute(
                            "data-disabled",
                            String(track.scrollLeft >= maxScroll),
                        );
                    };

                    track.addEventListener("scroll", updateButtons, {
                        passive: true,
                    });
                    window.addEventListener("resize", updateButtons);
                    updateButtons();
                });
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", initShotCarousels);
        } else {
            initShotCarousels();
        }
    </script>
</Layout>
