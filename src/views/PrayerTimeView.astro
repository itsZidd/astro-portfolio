---
import CaseStudyLayout from "../components/CaseStudyLayout.astro";
import { useTranslations, getLocalizedPath } from "../i18n/utils";
import type { Lang } from "../i18n/config";
import { prayerTimeContent, screenshotOrder } from "../content/prayerTime.ts";

interface Props {
    lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const c = prayerTimeContent[lang];

const screenshots = screenshotOrder.map((key) => ({
    src: `/work/prayer-time/${key}.png`,
    alt: c.screenshotAlts[key],
}));
---

<CaseStudyLayout
    lang={lang}
    pageTitle="Prayer Time — M. Zidan Malik"
    displayTitle="Prayer Time"
    eyebrow={t("case.eyebrow")}
    pitch={c.pitch}
    links={[
        {
            href: "https://github.com/itsZidd/expo-prayer-time/releases/download/1.0.0/application-375dc22a-becb-4ab2-8312-4a8f3002da15.apk",
            label: t("case.downloadApk"),
            icon: "download",
            variant: "primary",
        },
        {
            href: "https://github.com/itsZidd/expo-prayer-time",
            label: t("case.viewGithub"),
            icon: "square-arrow-out-up-right",
            variant: "secondary",
            external: true,
        },
        {
            href: `${getLocalizedPath(lang, "/feedback")}?project=prayer-time`,
            label: t("case.giveFeedback"),
            icon: "message-square",
            variant: "secondary",
        },
    ]}
    screenshots={screenshots}
    featureGroups={c.featureGroups}
    stackGroups={c.stackGroups}
    studyTitle={c.studyTitle}
    story={c.story}
    notes={c.notes}
/>
