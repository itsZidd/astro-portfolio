---
import CaseStudyLayout from "../components/CaseStudyLayout.astro";
import { useTranslations } from "../i18n/utils";
import type { Lang } from "../i18n/config";
import { icareLandslideContent, screenshotOrder } from "../content/icareLandslide.ts";

interface Props {
    lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const c = icareLandslideContent[lang];

const screenshots = screenshotOrder.map((key) => ({
    src: `/work/ic-learn/${key}.png`,
    alt: c.screenshotAlts[key],
}));
---

<CaseStudyLayout
    lang={lang}
    pageTitle="I-CARE Landslide — M. Zidan Malik"
    displayTitle="I-CARE Landslide"
    eyebrow={c.eyebrow}
    pitch={c.pitch}
    links={[
        {
            href: "https://ic-learn-landslide.vercel.app/",
            label: t("case.tryLive"),
            icon: "globe",
            variant: "primary",
            external: true,
        },
    ]}
    screenshots={screenshots}
    featureGroups={c.featureGroups}
    stackGroups={c.stackGroups}
    studyTitle={c.studyTitle}
    story={c.story}
    notes={c.notes}
/>
