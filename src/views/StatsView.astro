---
import Layout from "../layouts/Layout.astro";
import TechIcon from "../components/TechIcon.astro";
import Icon from "../components/Icon.astro";
import { projects } from "../data/projects.ts";
import { getTechCounts } from "../lib/tech.ts";
import { useTranslations, getLocalizedPath } from "../i18n/utils";
import type { Lang } from "../i18n/config";

interface Props {
    lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const counts = getTechCounts();
const maxCount = Math.max(1, ...counts.map((c) => c.count));
const tags = counts.map((c) => ({
    ...c,
    ratio: maxCount > 1 ? (c.count - 1) / (maxCount - 1) : 0,
    pct: Math.round((c.count / projects.length) * 100),
}));
---

<Layout title={`${t("stats.title")} — M. Zidan Malik`}>
    <section class="stats">
        <div class="wrap">
            <div class="stats__header">
                <div class="stats__back-wrap">
                    <a href={getLocalizedPath(lang, "/#work")} class="back-link btn btn-secondary">
                        <Icon name="arrow-left" size={14} />
                        {t("case.back")}
                    </a>
                </div>

                <div class="stats__title-wrap">
                    <span class="eyebrow">{t("stats.eyebrow")}</span>
                    <h1 class="h-display stats__title">{t("stats.title")}</h1>
                    <p class="stats__intro">{t("stats.intro")}</p>
                </div>

                {
                    tags.length > 0 && (
                        <div class="stats__summary-badge">
                            <span class="status-dot"></span>
                            <span>
                                {projects.length} {t("stats.projects")} · {tags.length}{" "}
                                {t("stats.technologies")}
                            </span>
                        </div>
                    )
                }
            </div>

            {
                tags.length === 0 ? (
                    <p class="stats__empty">{t("stats.empty")}</p>
                ) : (
                    <div class="tech-matrix">
                        {tags.map((tag) => (
                            <a
                                class="tech-card glass-panel"
                                href={getLocalizedPath(lang, `/stats/${tag.slug}`)}
                            >
                                <div class="tech-card__top">
                                    <div class="tech-card__icon-box">
                                        <TechIcon name={tag.name} size={20} />
                                    </div>
                                    <span class="tech-card__count">
                                        {tag.count} {tag.count === 1 ? t("stats.project") : t("stats.projects")}
                                    </span>
                                </div>

                                <div class="tech-card__body">
                                    <h3 class="tech-card__name">{tag.name}</h3>
                                    <div class="tech-card__progress-bar">
                                        <div
                                            class="tech-card__progress-fill"
                                            style={`width: ${Math.max(20, tag.pct)}%`}
                                        ></div>
                                    </div>
                                </div>

                                <div class="tech-card__footer">
                                    <span class="tech-card__action">
                                        {t("stats.techLabel")}
                                        <Icon name="arrow-right" size={12} />
                                    </span>
                                </div>
                            </a>
                        ))}
                    </div>
                )
            }
        </div>
    </section>

    <style>
        .stats {
            padding-block: 40px 96px;
        }
        .stats__back-wrap {
            margin-bottom: 24px;
        }
        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .stats__title-wrap {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        .stats__title {
            font-size: clamp(2.6rem, 6vw, 4rem);
            margin: 4px 0 0;
            background: linear-gradient(180deg, #ffffff 40%, rgba(244, 243, 236, 0.75) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .stats__intro {
            max-width: 60ch;
            color: var(--text-secondary);
            font-size: 16px;
            line-height: 1.65;
            margin: 12px 0 0;
            text-align: justify;
            text-justify: inter-word;
            text-align-last: left;
            hyphens: auto;
            -webkit-hyphens: auto;
            text-wrap: pretty;
        }
        .stats__summary-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-family: var(--font-heading);
            font-weight: 600;
            font-size: 13px;
            color: var(--accent);
            background: rgba(151, 196, 89, 0.08);
            border: 1px solid rgba(151, 196, 89, 0.2);
            padding: 6px 14px;
            border-radius: 999px;
            margin-top: 24px;
        }
        .stats__empty {
            color: var(--text-secondary);
            font-size: 14px;
            margin: 40px 0 0;
        }

        .tech-matrix {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 20px;
            margin-top: 36px;
        }
        .tech-card {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 20px;
        }
        .tech-card__top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
        }
        .tech-card__icon-box {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 38px;
            height: 38px;
            background: rgba(151, 196, 89, 0.1);
            border: 1px solid rgba(151, 196, 89, 0.2);
            border-radius: 8px;
            color: var(--accent);
        }
        .tech-card__count {
            font-family: var(--font-heading);
            font-weight: 600;
            font-size: 12px;
            color: var(--accent);
            background: rgba(151, 196, 89, 0.08);
            border: 1px solid rgba(151, 196, 89, 0.18);
            padding: 3px 8px;
            border-radius: 999px;
        }
        .tech-card__name {
            font-family: var(--font-heading);
            font-size: 18px;
            font-weight: 700;
            color: var(--text);
            margin: 0 0 10px;
        }
        .tech-card__progress-bar {
            width: 100%;
            height: 4px;
            background: rgba(255, 255, 255, 0.06);
            border-radius: 2px;
            overflow: hidden;
        }
        .tech-card__progress-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--green-500), var(--green-100));
            border-radius: 2px;
        }
        .tech-card__footer {
            margin-top: 18px;
            padding-top: 12px;
            border-top: 1px solid var(--border-soft);
        }
        .tech-card__action {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-family: var(--font-heading);
            font-weight: 600;
            font-size: 12.5px;
            color: var(--text-faint);
            transition: color 0.2s ease, gap 0.2s ease;
        }
        .tech-card:hover .tech-card__action {
            color: var(--accent);
            gap: 10px;
        }
    </style>
</Layout>
