---
import Layout from "../layouts/Layout.astro";
import ContourField from "../components/ContourField.astro";
import Icon from "../components/Icon.astro";
import TechIcon from "../components/TechIcon.astro";
import { projects } from "../data/projects.ts";
import { useTranslations, getLocalizedPath, getProjectText } from "../i18n/utils";
import type { Lang } from "../i18n/config";

interface Props {
    lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const skillGroups = [
    {
        label: t("skills.software"),
        items: [
            "JavaScript",
            "TypeScript",
            "Go",
            "Python",
            "React Native",
            "Godot",
        ],
    },
    {
        label: t("skills.gis"),
        items: [
            "QGIS",
            "ArcGIS Pro",
            "Google Earth Engine",
            "Remote sensing",
            "Cartography",
        ],
    },
    {
        label: t("skills.aiml"),
        items: [
            "RAG systems",
            "LangChain",
            "LlamaIndex",
            "Classification models",
        ],
    },
];
---

<Layout title="M. Zidan Malik — Software Developer & Geographer">
    <section class="hero">
        <ContourField seed={23} levels={13} opacity={0.55} />
        <div class="wrap hero__inner">
            <p class="eyebrow">-7.9666, 112.5183</p>
            <h1 class="h-display hero__name">M. Zidan Malik</h1>
            <p class="hero__role">{t("hero.role")}</p>
            <p class="hero__intro">{t("hero.intro")}</p>
        </div>
    </section>

    <section id="work" class="work">
        <div class="wrap">
            <h2 class="section-title">{t("work.title")}</h2>
            <div class="project-grid">
                {
                    projects.map((p) => {
                        const text = getProjectText(lang, p);
                        return (
                            <a class="project-card" href={getLocalizedPath(lang, `/work/${p.slug}`)}>
                                <div class="project-card__top">
                                    <span class="project-card__file">{p.file}</span>
                                    <span
                                        class={`project-card__status project-card__status--${p.status}`}
                                    >
                                        {p.status === "live"
                                            ? t("status.live")
                                            : t("status.progress")}
                                    </span>
                                </div>
                                <h3 class="project-card__title">{text.title}</h3>
                                <p class="project-card__summary">{text.summary}</p>
                                <div class="project-card__stack">
                                    {p.stack.map((s) => (
                                        <span>
                                            <TechIcon name={s} size={12} />
                                            {s}
                                        </span>
                                    ))}
                                </div>
                            </a>
                        );
                    })
                }
            </div>
        </div>
    </section>

    <section id="about" class="about">
        <div class="wrap">
            <h2 class="section-title">{t("about.title")}</h2>
            <p class="about__text">{t("about.text")}</p>
            <div class="skills-grid">
                {
                    skillGroups.map((g) => (
                        <div class="skills-group">
                            <p class="eyebrow">{g.label}</p>
                            <ul>
                                {g.items.map((item) => (
                                    <li>
                                        <TechIcon name={item} size={15} />
                                        {item}
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <section id="contact" class="contact">
        <div class="wrap">
            <h2 class="section-title">{t("contact.title")}</h2>
            <p class="about__text">{t("contact.text")}</p>
            <div class="contact__links">
                <a href="mailto:mziddanmalik@gmail.com" class="contact__link">
                    <Icon name="mail" size={15} />
                    mziddanmalik@gmail.com
                </a>
                <a
                    href="https://github.com/itsZidd"
                    class="contact__link"
                    target="_blank"
                    rel="noreferrer"
                >
                    <Icon name="square-arrow-out-up-right" size={15} />
                    github.com/itsZidd
                </a>
            </div>
        </div>
    </section>

    <style>
        .hero {
            position: relative;
            min-height: 620px;
            display: flex;
            align-items: flex-end;
            overflow: hidden;
            border-bottom: 0.5px solid var(--border-soft);
        }
        .hero__inner {
            position: relative;
            z-index: 1;
            padding-block: 48px 64px;
        }
        .hero__name {
            font-size: clamp(3.2rem, 9vw, 6.5rem);
            margin: 10px 0 0;
            color: var(--text);
        }
        .hero__role {
            font-family: var(--font-mono);
            font-size: 15px;
            color: var(--accent-strong);
            margin: 14px 0 0;
        }
        .hero__intro {
            max-width: 46ch;
            color: var(--text-secondary);
            margin: 16px 0 0;
            font-size: 16px;
        }

        .section-title {
            font-family: var(--font-display);
            text-transform: uppercase;
            letter-spacing: 0.02em;
            font-size: 1.5rem;
            color: var(--text);
            margin: 0 0 28px;
            padding-top: 72px;
        }

        .project-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 16px;
        }
        .project-card {
            display: block;
            background: var(--surface);
            border: 0.5px solid var(--border);
            border-radius: var(--radius);
            padding: 18px 20px;
            transition:
                border-color 0.15s ease,
                transform 0.15s ease;
        }
        .project-card:hover {
            border-color: var(--green-300);
            transform: translateY(-2px);
        }
        .project-card__top {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .project-card__file {
            font-family: var(--font-mono);
            font-size: 12px;
            color: var(--green-100);
        }
        .project-card__status {
            font-family: var(--font-mono);
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            padding: 2px 6px;
            border-radius: 4px;
            border: 0.5px solid var(--border);
            color: var(--text-faint);
        }
        .project-card__status--live {
            color: var(--green-100);
            border-color: var(--green-500);
        }
        .project-card__title {
            font-family: var(--font-body);
            font-weight: 600;
            font-size: 17px;
            margin: 12px 0 6px;
            color: var(--text);
        }
        .project-card__summary {
            font-size: 13.5px;
            color: var(--text-secondary);
            margin: 0 0 14px;
            line-height: 1.5;
        }
        .project-card__stack {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }
        .project-card__stack span {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-family: var(--font-mono);
            font-size: 10.5px;
            color: var(--text-faint);
            border: 0.5px solid var(--border-soft);
            border-radius: 4px;
            padding: 2px 6px;
        }

        .about__text {
            max-width: 62ch;
            color: var(--text-secondary);
            font-size: 15px;
        }
        .skills-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 24px;
            margin-top: 32px;
        }
        .skills-group ul {
            list-style: none;
            margin: 10px 0 0;
            padding: 0;
        }
        .skills-group li {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 14px;
            color: var(--text);
            padding: 6px 0;
            border-bottom: 0.5px solid var(--border-soft);
        }
        .skills-group li :global(svg) {
            flex-shrink: 0;
            color: var(--text-faint);
        }

        .contact {
            padding-bottom: 40px;
        }
        .contact__links {
            display: flex;
            gap: 24px;
            margin-top: 20px;
            flex-wrap: wrap;
        }
        .contact__link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-family: var(--font-mono);
            font-size: 14px;
            color: var(--accent);
            border-bottom: 0.5px solid var(--green-500);
            padding-bottom: 2px;
        }
        .contact__link:hover {
            color: var(--accent-strong);
            border-color: var(--amber-300);
        }

        @media (max-width: 640px) {
            .hero {
                min-height: 520px;
            }
            .hero__inner {
                padding-block: 32px 40px;
            }
        }
    </style>
</Layout>
