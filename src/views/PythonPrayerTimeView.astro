---
import CaseStudyLayout from "../components/CaseStudyLayout.astro";
import { useTranslations, getLocalizedPath } from "../i18n/utils";
import type { Lang } from "../i18n/config";
import { pythonPrayerTimeContent } from "../content/pythonPrayerTime.ts";

interface Props {
    lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const c = pythonPrayerTimeContent[lang];
---

<CaseStudyLayout
    lang={lang}
    pageTitle="Smart Prayer Times API & CLI — M. Zidan Malik"
    displayTitle="Smart Prayer Times API & CLI"
    eyebrow={c.eyebrow}
    pitch={c.pitch}
    links={[
        {
            href: "https://python-prayer-time-calculation.vercel.app/docs",
            label: t("case.tryLive"),
            icon: "globe",
            variant: "primary",
            external: true,
        },
        {
            href: "https://github.com/itsZidd/python-prayer-time-calculation",
            label: t("case.viewGithub"),
            icon: "square-arrow-out-up-right",
            variant: "secondary",
            external: true,
        },
        {
            href: `${getLocalizedPath(lang, "/feedback")}?project=python-prayer-time`,
            label: t("case.giveFeedback"),
            icon: "message-square",
            variant: "secondary",
        },
    ]}
    featureGroups={c.featureGroups}
    stackGroups={c.stackGroups}
    studyTitle={c.studyTitle}
    story={c.story}
    notes={c.notes}
/>
