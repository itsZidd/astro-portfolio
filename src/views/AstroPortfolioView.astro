---
import CaseStudyLayout from "../components/CaseStudyLayout.astro";
import { useTranslations, getLocalizedPath } from "../i18n/utils";
import type { Lang } from "../i18n/config";
import { astroPortfolioContent } from "../content/astroPortfolio.ts";

interface Props {
    lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const c = astroPortfolioContent[lang];
---

<CaseStudyLayout
    lang={lang}
    pageTitle="Astro Portfolio — M. Zidan Malik"
    displayTitle="Astro Portfolio"
    eyebrow={c.eyebrow}
    pitch={c.pitch}
    links={[
        {
            href: "https://github.com/itsZidd/astro-portfolio",
            label: t("case.viewGithub"),
            icon: "square-arrow-out-up-right",
            variant: "primary",
            external: true,
        },
        {
            href: `${getLocalizedPath(lang, "/feedback")}?project=astro-portfolio`,
            label: t("case.giveFeedback"),
            icon: "message-square",
            variant: "secondary",
        },
    ]}
    featureGroups={c.featureGroups}
    stackGroups={c.stackGroups}
    studyTitle={c.studyTitle}
    story={c.story}
    notes={c.notes}
/>
