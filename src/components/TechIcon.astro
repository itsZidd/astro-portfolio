---
import fs from "node:fs";
import { createRequire } from "node:module";
import { findTechIconSlug, getCustomTechIcon } from "../lib/icons.ts";

interface Props {
    name: string;
    size?: number | string;
    class?: string;
}

const { name, size = 15, class: className } = Astro.props;

const customSvg = getCustomTechIcon(name);
const slug = findTechIconSlug(name);

let svg = "";

if (customSvg) {
    const attrs = `aria-hidden="true" width="${size}" height="${size}" fill="currentColor"${className ? ` class="${className}"` : ""}`;
    svg = customSvg.replace("<svg", `<svg ${attrs}`);
} else if (slug) {
    try {
        const require = createRequire(import.meta.url);
        const iconPath = require.resolve(`simple-icons/icons/${slug}.svg`);
        svg = fs.readFileSync(iconPath, "utf-8").replace(/<title>.*?<\/title>/, "");
        const attrs = `aria-hidden="true" width="${size}" height="${size}" fill="currentColor"${className ? ` class="${className}"` : ""}`;
        svg = svg.replace("<svg", `<svg ${attrs}`);
    } catch {
        svg = "";
    }
}

// Universal fallback icon if no specific logo exists
if (!svg) {
    const attrs = `aria-hidden="true" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"${className ? ` class="${className}"` : ""}`;
    svg = `<svg ${attrs}><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>`;
}
---

{svg && <Fragment set:html={svg} />}
