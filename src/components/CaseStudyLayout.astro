---
import Layout from "../layouts/Layout.astro";
import Icon from "./Icon.astro";
import TechIcon from "./TechIcon.astro";
import { hasTechIcon } from "../lib/icons.ts";
import { useTranslations, getLocalizedPath } from "../i18n/utils";
import type { Lang } from "../i18n/config";

interface Group {
    label: string;
    items: string[];
}

interface StoryBlock {
    label: string;
    body: string;
}

interface Note {
    title: string;
    body: string;
}

interface Screenshot {
    src: string;
    alt: string;
}

interface LinkAction {
    href: string;
    label: string;
    icon: string;
    variant: "primary" | "secondary";
    external?: boolean;
}

interface Props {
    lang: Lang;
    pageTitle: string;
    displayTitle: string;
    eyebrow: string;
    pitch: string;
    links: LinkAction[];
    featureGroups: Group[];
    stackGroups: Group[];
    studyTitle: string;
    story: StoryBlock[];
    notes: Note[];
    screenshots?: Screenshot[];
}

const {
    lang,
    pageTitle,
    displayTitle,
    eyebrow,
    pitch,
    links,
    featureGroups,
    stackGroups,
    studyTitle,
    story,
    notes,
    screenshots = [],
} = Astro.props;

const t = useTranslations(lang);

/**
 * Escapes HTML, then turns `backtick` segments into <code> spans
 * and *asterisk* segments into <em> spans (for italicized loanwords).
 * Content is our own dictionary text (not user input), but escaping
 * first keeps this safe regardless.
 */
function inlineFormat(raw: string): string {
    const escaped = raw
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;");
    return escaped
        .replace(/`([^`]+)`/g, "<code>$1</code>")
        .replace(/\*([^*]+)\*/g, "<em>$1</em>");
}
---

<Layout title={pageTitle}>
    <article class="case">
        <div class="wrap">
            <div class="case__back-wrap">
                <a href={getLocalizedPath(lang, "/#work")} class="case__back btn btn-secondary">
                    <Icon name="arrow-left" size={14} />
                    {t("case.back")}
                </a>
            </div>

            <p class="eyebrow">{eyebrow}</p>
            <h1 class="h-display case__title">{displayTitle}</h1>
            <p class="case__pitch" set:html={inlineFormat(pitch)} />

            {
                links.length > 0 && (
                    <div class="case__links">
                        {links.map((l) => (
                            <a
                                class={`btn btn-${l.variant}`}
                                href={l.href}
                                target={l.external ? "_blank" : undefined}
                                rel={l.external ? "noreferrer" : undefined}
                            >
                                <Icon name={l.icon} size={15} />
                                {l.label}
                            </a>
                        ))}
                    </div>
                )
            }
        </div>

        {
            screenshots.length > 0 && (
                <section class="wrap case__section">
                    <h2 class="section-title">{t("case.screens")}</h2>
                    <div class="shot-carousel">
                        <div class="shot-nav-wrap shot-nav-wrap--prev">
                            <button class="shot-nav" aria-label={t("case.scrollLeft")} type="button">
                                <Icon name="chevron-left" size={24} strokeWidth={2.25} />
                            </button>
                        </div>
                        <div class="shot-grid">
                            {screenshots.map((s) => (
                                <div class="shot glass-panel">
                                    <img src={s.src} alt={s.alt} loading="lazy" />
                                </div>
                            ))}
                        </div>
                        <div class="shot-nav-wrap shot-nav-wrap--next">
                            <button class="shot-nav" aria-label={t("case.scrollRight")} type="button">
                                <Icon name="chevron-right" size={24} strokeWidth={2.25} />
                            </button>
                        </div>
                    </div>
                </section>
            )
        }

        <section class="wrap case__section">
            <h2 class="section-title">{t("case.whatsBuilt")}</h2>
            <div class="features-grid">
                {
                    featureGroups.map((g, idx) => (
                        <div class="feature-card glass-panel">
                            <div class="feature-card__header">
                                <span class="feature-card__num">{String(idx + 1).padStart(2, "0")}</span>
                                <h3 class="feature-card__title">{g.label}</h3>
                            </div>
                            <ul class="feature-card__list">
                                {g.items.map((item) => (
                                    <li class="feature-card__item">
                                        <span class="feature-card__bullet" aria-hidden="true">
                                            <Icon name="chevron-right" size={13} strokeWidth={2.5} />
                                        </span>
                                        <div class="feature-card__text" set:html={inlineFormat(item)} />
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))
                }
            </div>
        </section>

        <section class="wrap case__section">
            <h2 class="section-title">{t("case.techStack")}</h2>
            <div class="stack-grid">
                {
                    stackGroups.map((g) => (
                        <div class="stack-group glass-panel">
                            <p class="eyebrow">{g.label}</p>
                            <ul>
                                {g.items.map((item) => (
                                    <li>
                                        {hasTechIcon(item) && (
                                            <span class="tech-slot">
                                                <TechIcon name={item} size={14} />
                                            </span>
                                        )}
                                        <span>{item}</span>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))
                }
            </div>
        </section>

        <section class="wrap case__section">
            <h2 class="section-title">{studyTitle}</h2>

            <div class="story">
                {
                    story.map((block) => (
                        <div class="story__block glass-panel">
                            <p class="story__label">{block.label}</p>
                            <p set:html={inlineFormat(block.body)} />
                        </div>
                    ))
                }
            </div>
        </section>

        <section class="wrap case__section case__section--last">
            <h2 class="section-title">{t("case.limitations")}</h2>
            <div class="notes">
                {
                    notes.map((n) => (
                        <div class="notes__item glass-panel">
                            <p class="notes__title">{n.title}</p>
                            <p set:html={inlineFormat(n.body)} />
                        </div>
                    ))
                }
            </div>
        </section>
    </article>

    <style>
        .case {
            padding-block: 40px 96px;
        }
        .case__back-wrap {
            margin-bottom: 24px;
        }
        .case__title {
            font-size: clamp(2.8rem, 7vw, 4.5rem);
            margin: 6px 0 0;
            background: linear-gradient(180deg, #ffffff 40%, rgba(244, 243, 236, 0.75) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .case__pitch {
            max-width: 60ch;
            color: var(--text-secondary);
            font-size: 17px;
            line-height: 1.65;
            margin: 16px 0 0;
            text-align: justify;
            text-justify: inter-word;
        }
        .case__links {
            margin-top: 28px;
            display: flex;
            gap: 14px;
            flex-wrap: wrap;
        }

        .case__section {
            margin-top: 64px;
        }
        .case__section--last {
            padding-bottom: 80px;
        }

        .section-title {
            font-family: var(--font-display);
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            font-size: 2rem;
            color: var(--text);
            margin: 0 0 28px;
        }

        /* What's Built Feature Grid */
        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 22px;
        }
        .feature-card {
            position: relative;
            padding: 26px;
            display: flex;
            flex-direction: column;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            background: linear-gradient(145deg, rgba(18, 20, 17, 0.85) 0%, rgba(26, 29, 23, 0.65) 100%);
            transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
            overflow: hidden;
        }
        .feature-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg, var(--teal-500), var(--green-100), transparent);
            opacity: 0.5;
            transition: opacity 0.25s ease;
        }
        .feature-card:hover {
            transform: translateY(-3px);
            border-color: var(--accent);
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45), 0 0 20px var(--glow-emerald);
        }
        .feature-card:hover::before {
            opacity: 1;
        }
        .feature-card__header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 18px;
            padding-bottom: 14px;
            border-bottom: 1px solid var(--border-soft);
        }
        .feature-card__num {
            font-family: var(--font-mono);
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.06em;
            color: var(--green-100);
            background: rgba(151, 196, 89, 0.1);
            border: 1px solid rgba(151, 196, 89, 0.22);
            padding: 3px 8px;
            border-radius: 6px;
            flex-shrink: 0;
        }
        .feature-card__title {
            font-family: var(--font-heading);
            font-size: 1.15rem;
            font-weight: 700;
            letter-spacing: 0.01em;
            color: var(--text);
            margin: 0;
            line-height: 1.3;
        }
        .feature-card__list {
            list-style: none;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            gap: 12px;
            flex: 1;
        }
        .feature-card__item {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            font-size: 14.5px;
            color: var(--text-secondary);
            line-height: 1.6;
            text-align: justify;
            text-justify: inter-word;
        }
        .feature-card__bullet {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 18px;
            height: 18px;
            border-radius: 4px;
            background: rgba(151, 196, 89, 0.08);
            color: var(--accent);
            flex-shrink: 0;
            margin-top: 3px;
            transition: background 0.2s ease, transform 0.2s ease;
        }
        .feature-card:hover .feature-card__bullet {
            background: rgba(151, 196, 89, 0.2);
            transform: translateX(2px);
        }
        .feature-card__text {
            flex: 1;
            min-width: 0;
        }
        .feature-card__text :global(code) {
            font-family: var(--font-mono);
            font-size: 0.9em;
            color: var(--green-100);
            background: var(--surface-2);
            padding: 1px 5px;
            border-radius: 4px;
        }

        .stack-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
        }
        .stack-group {
            padding: 24px;
        }
        .stack-group ul {
            list-style: none;
            margin: 12px 0 0;
            padding: 0;
        }
        .stack-group li {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            font-size: 14px;
            color: var(--text-secondary);
            line-height: 1.55;
            padding: 8px 0;
            border-bottom: 1px solid var(--border-soft);
            text-align: justify;
            text-justify: inter-word;
        }
        .stack-group li:last-child {
            border-bottom: none;
        }
        .stack-group .tech-slot {
            display: inline-flex;
            width: 16px;
            margin-top: 3px;
            flex-shrink: 0;
            color: var(--accent);
        }

        .story {
            display: grid;
            gap: 20px;
        }
        .story__block {
            padding: 24px;
            min-width: 0;
            overflow: hidden;
            box-sizing: border-box;
        }
        .story__label {
            font-family: var(--font-display);
            font-size: 1.35rem;
            font-weight: 700;
            text-transform: uppercase;
            line-height: 1.3;
            letter-spacing: 0.04em;
            color: var(--amber-100);
            margin: 0 0 14px;
            padding-bottom: 10px;
            border-bottom: 1px solid rgba(239, 159, 39, 0.35);
            display: flex;
            align-items: center;
            gap: 10px;
            text-align: left !important;
            text-justify: auto !important;
        }
        .story__label::before {
            content: "";
            display: inline-block;
            width: 4px;
            height: 16px;
            background: var(--amber-300);
            border-radius: 2px;
            flex-shrink: 0;
        }
        .story__block p {
            color: var(--text-secondary);
            font-size: 15px;
            line-height: 1.65;
            margin: 0;
            text-align: justify;
            text-justify: inter-word;
        }
        .story__block :global(code) {
            font-family: var(--font-mono);
            font-size: 0.9em;
            color: var(--green-100);
            background: rgba(151, 196, 89, 0.1);
            padding: 2px 6px;
            border-radius: 4px;
            word-break: break-all;
            overflow-wrap: break-word;
            white-space: pre-wrap;
            display: inline;
            max-width: 100%;
        }

        .notes {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
        }
        .notes__item {
            padding: 24px;
            min-width: 0;
            overflow: hidden;
            box-sizing: border-box;
        }
        .notes__item .notes__title {
            font-family: var(--font-display);
            font-weight: 700;
            font-size: 1.3rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            color: var(--green-100);
            margin: 0 0 14px;
            padding-bottom: 10px;
            border-bottom: 1px solid rgba(151, 196, 89, 0.35);
            text-align: left !important;
            text-justify: auto !important;
        }
        .notes__item p {
            color: var(--text-secondary);
            font-size: 14.5px;
            line-height: 1.6;
            margin: 0;
            text-align: justify;
            text-justify: inter-word;
        }
        .notes__item :global(code) {
            font-family: var(--font-mono);
            font-size: 0.9em;
            color: var(--green-100);
            background: var(--surface-2);
            padding: 1px 5px;
            border-radius: 4px;
        }

        .shot-carousel {
            position: relative;
        }
        .shot-nav-wrap {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            margin-top: -4px;
            z-index: 10;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
        }
        .shot-nav-wrap--prev {
            left: -20px;
        }
        .shot-nav-wrap--next {
            right: -20px;
        }
        .shot-nav {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            border: 1px solid var(--border);
            background: rgba(18, 20, 17, 0.88);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            color: var(--text);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 6px 22px rgba(0, 0, 0, 0.6);
            transition:
                background 0.15s ease,
                border-color 0.15s ease,
                color 0.15s ease,
                transform 0.15s ease;
        }
        .shot-nav:hover {
            background: rgba(28, 30, 24, 0.98);
            border-color: var(--accent);
            color: var(--accent);
            transform: scale(1.08);
        }
        .shot-nav-wrap[data-disabled="true"] {
            opacity: 0;
            pointer-events: none;
        }
        @media (hover: none) {
            .shot-nav-wrap {
                display: none;
            }
        }

        .shot-grid {
            display: flex;
            gap: 14px;
            overflow-x: auto;
            overflow-y: hidden;
            padding-bottom: 8px;
            scroll-snap-type: x mandatory;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: thin;
            scrollbar-color: var(--border) transparent;
        }
        .shot-grid::-webkit-scrollbar {
            height: 8px;
        }
        .shot-grid::-webkit-scrollbar-track {
            background: transparent;
        }
        .shot-grid::-webkit-scrollbar-thumb {
            background: var(--border);
            border-radius: 8px;
        }
        .shot {
            position: relative;
            flex: 0 0 auto;
            scroll-snap-align: start;
            height: 400px;
            min-width: 280px;
            aspect-ratio: 16 / 10;
            border: 0.5px solid var(--border);
            border-radius: var(--radius);
            overflow: hidden;
            background: linear-gradient(
                90deg,
                rgba(18, 20, 17, 0.8) 0%,
                rgba(151, 196, 89, 0.08) 50%,
                rgba(18, 20, 17, 0.8) 100%
            );
            background-size: 200% 100%;
            animation: skeleton-shimmer 2s ease-in-out infinite;
        }
        .shot img {
            position: relative;
            z-index: 1;
            height: 100%;
            width: auto;
            display: block;
            opacity: 0;
            transition: opacity 0.35s ease;
        }
        .shot img.is-loaded {
            opacity: 1;
        }
        @media (max-width: 640px) {
            .shot {
                height: 320px;
                min-width: 220px;
            }
        }
    </style>

    <script>
        function initShotCarousels() {
            document
                .querySelectorAll<HTMLElement>(".shot-carousel")
                .forEach((carousel) => {
                    const track =
                        carousel.querySelector<HTMLElement>(".shot-grid");
                    const prevWrap = carousel.querySelector<HTMLElement>(
                        ".shot-nav-wrap--prev",
                    );
                    const nextWrap = carousel.querySelector<HTMLElement>(
                        ".shot-nav-wrap--next",
                    );
                    const prevBtn =
                        prevWrap?.querySelector<HTMLButtonElement>(".shot-nav");
                    const nextBtn =
                        nextWrap?.querySelector<HTMLButtonElement>(".shot-nav");
                    if (
                        !track ||
                        !prevWrap ||
                        !nextWrap ||
                        !prevBtn ||
                        !nextBtn
                    )
                        return;

                    const scrollByAmount = () =>
                        Math.round(track.clientWidth * 0.8);

                    prevBtn.onclick = () => {
                        track.scrollBy({
                            left: -scrollByAmount(),
                            behavior: "smooth",
                        });
                    };
                    nextBtn.onclick = () => {
                        track.scrollBy({
                            left: scrollByAmount(),
                            behavior: "smooth",
                        });
                    };

                    const updateButtons = () => {
                        const maxScroll = track.scrollWidth - track.clientWidth;
                        const canScrollPrev = track.scrollLeft > 4;
                        const hasOverflow = track.scrollWidth > track.clientWidth + 4;
                        const canScrollNext = hasOverflow && track.scrollLeft < maxScroll - 4;

                        prevWrap.setAttribute(
                            "data-disabled",
                            String(!canScrollPrev),
                        );
                        nextWrap.setAttribute(
                            "data-disabled",
                            String(!canScrollNext),
                        );
                    };

                    const imgs = track.querySelectorAll<HTMLImageElement>("img");
                    imgs.forEach((img) => {
                        const handleLoad = () => {
                            img.classList.add("is-loaded");
                            updateButtons();
                        };
                        if (img.complete && img.naturalWidth > 0) {
                            handleLoad();
                        } else {
                            img.addEventListener("load", handleLoad, { once: true });
                            img.addEventListener("error", handleLoad, { once: true });
                        }
                    });

                    track.addEventListener("scroll", updateButtons, {
                        passive: true,
                    });
                    window.addEventListener("resize", updateButtons);

                    if (window.ResizeObserver) {
                        const ro = new ResizeObserver(() => updateButtons());
                        ro.observe(track);
                    }

                    updateButtons();
                    setTimeout(updateButtons, 100);
                    setTimeout(updateButtons, 350);
                });
        }

        document.addEventListener("astro:page-load", initShotCarousels);
        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", initShotCarousels);
        } else {
            initShotCarousels();
        }
    </script>
</Layout>
