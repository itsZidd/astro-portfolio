---
import Icon from "./Icon.astro";
import { certificates } from "../data/certificates";
import { useTranslations } from "../i18n/utils";
import type { Lang } from "../i18n/config";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

function inlineFormat(raw: string): string {
    const escaped = raw
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;");
    return escaped
        .replace(/`([^`]+)`/g, "<code>$1</code>")
        .replace(/\*([^*]+)\*/g, "<em>$1</em>");
}
---

<section id="certificates" class="certificates">
    <div class="wrap">
        <div class="section-header">
            <div>
                <span class="eyebrow">{t("cert.eyebrow")}</span>
                <h2 class="section-title">{t("cert.title")}</h2>
            </div>
            <p class="section-intro" set:html={inlineFormat(t("cert.intro"))}></p>
        </div>

        <div class="cert-grid">
            {
                certificates.map((cert) => (
                    <div class="cert-card glass-panel">
                        <div class="cert-card__top">
                            <span class={`cert-card__platform cert-card__platform--${cert.platform.toLowerCase()}`}>
                                {cert.platform}
                            </span>
                            <span class="cert-card__date">{cert.issueDate}</span>
                        </div>

                        <h3 class="cert-card__title">{cert.title}</h3>
                        <p class="cert-card__issuer">{cert.issuer}</p>

                        {cert.description && (
                            <p class="cert-card__desc" set:html={inlineFormat(cert.description[lang])}></p>
                        )}

                        <div class="cert-card__bottom">
                            <div class="cert-card__skills">
                                {cert.skills.map((skill) => (
                                    <span class="cert-chip">{skill}</span>
                                ))}
                            </div>

                            {cert.credentialUrl && (
                                <div class="cert-card__action">
                                    <a
                                        href={cert.credentialUrl}
                                        target="_blank"
                                        rel="noreferrer"
                                        class="cert-btn"
                                        aria-label={`${t("cert.verify")}: ${cert.title}`}
                                    >
                                        <span>{t("cert.verify")}</span>
                                        <Icon name="square-arrow-out-up-right" size={13} />
                                    </a>
                                    {cert.id === "bnsp-remote-sensing-kualifikasi-6" && (
                                        <a
                                            href="/certificates/bnsp-remote-sensing-back.jpg"
                                            target="_blank"
                                            rel="noreferrer"
                                            class="cert-btn cert-btn--subtle"
                                            aria-label="Lihat Daftar Unit Kompetensi (Halaman Belakang)"
                                        >
                                            <span>{lang === "id" ? "Unit Kompetensi (Hal. 2)" : "Competencies (Back)"}</span>
                                            <Icon name="square-arrow-out-up-right" size={12} />
                                        </a>
                                    )}
                                </div>
                            )}
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    .certificates {
        padding-block: 70px;
        border-top: 1px solid var(--border-soft);
    }
    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 36px;
        flex-wrap: wrap;
        gap: 16px;
    }
    .section-title {
        font-family: var(--font-display);
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        font-size: 2.4rem;
        color: var(--text);
        margin: 6px 0 0;
    }
    .section-intro {
        max-width: 52ch;
        color: var(--text-secondary);
        font-size: 15px;
        line-height: 1.6;
        margin: 0;
        text-align: justify;
        text-justify: inter-word;
        text-align-last: left;
        hyphens: auto;
        -webkit-hyphens: auto;
        text-wrap: pretty;
    }

    .cert-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 22px;
    }

    .cert-card {
        padding: 26px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        border-radius: var(--radius);
        background: linear-gradient(145deg, rgba(18, 20, 17, 0.88) 0%, rgba(26, 29, 23, 0.65) 100%);
        border: 1px solid var(--border);
        transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    }

    .cert-card:hover {
        transform: translateY(-3px);
        border-color: var(--accent);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45), 0 0 20px var(--glow-emerald);
    }

    .cert-card__top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        margin-bottom: 14px;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--border-soft);
    }

    .cert-card__platform {
        font-family: var(--font-mono);
        font-size: 11.5px;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 3px 10px;
        border-radius: 4px;
        border: 1px solid var(--border);
    }

    .cert-card__platform--bnsp {
        color: var(--green-100);
        background: rgba(151, 196, 89, 0.12);
        border-color: rgba(151, 196, 89, 0.3);
        box-shadow: 0 0 8px var(--glow-emerald);
    }

    .cert-card__platform--esri {
        color: var(--teal-500);
        background: rgba(45, 212, 191, 0.1);
        border-color: rgba(45, 212, 191, 0.25);
    }

    .cert-card__platform--edx {
        color: var(--amber-300);
        background: rgba(239, 159, 39, 0.1);
        border-color: rgba(239, 159, 39, 0.25);
    }

    .cert-card__date {
        font-family: var(--font-mono);
        font-size: 11.5px;
        color: var(--text-faint);
    }

    .cert-card__title {
        font-family: var(--font-heading);
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--text);
        margin: 0 0 6px;
        line-height: 1.35;
    }

    .cert-card__issuer {
        font-size: 13.5px;
        color: var(--accent);
        font-weight: 500;
        margin: 0 0 12px;
    }

    .cert-card__desc {
        font-size: 13.5px;
        color: var(--text-secondary);
        line-height: 1.6;
        margin: 0 0 16px;
        text-align: justify;
        text-justify: inter-word;
        text-align-last: left;
        hyphens: auto;
        -webkit-hyphens: auto;
        text-wrap: pretty;
        flex-grow: 1;
    }

    .cert-card__bottom {
        display: flex;
        flex-direction: column;
        gap: 16px;
        margin-top: auto;
        padding-top: 14px;
        border-top: 1px solid var(--border-soft);
    }

    .cert-card__skills {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .cert-chip {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.05em;
        color: var(--text-secondary);
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 4px;
        padding: 3px 8px;
    }

    .cert-card__action {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .cert-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: var(--font-mono);
        font-size: 12px;
        letter-spacing: 0.06em;
        color: var(--accent);
        font-weight: 500;
        transition: all 0.2s ease;
        padding: 5px 12px;
        border-radius: var(--radius-sm);
        background: rgba(151, 196, 89, 0.08);
        border: 1px solid rgba(151, 196, 89, 0.22);
        width: fit-content;
    }

    .cert-btn:hover {
        background: rgba(151, 196, 89, 0.18);
        border-color: var(--accent);
        color: var(--accent-strong);
        gap: 11px;
    }

    .cert-btn--subtle {
        background: rgba(255, 255, 255, 0.04);
        border-color: var(--border);
        color: var(--text-secondary);
    }

    .cert-btn--subtle:hover {
        background: rgba(255, 255, 255, 0.08);
        border-color: var(--accent);
        color: var(--text);
        gap: 11px;
    }

    @media (max-width: 640px) {
        .cert-card {
            padding: 20px;
        }
        .cert-card__desc {
            text-align: left !important;
            text-justify: auto !important;
            text-align-last: left !important;
        }
    }
</style>
