---
import Icon from "./Icon.astro";
---

<div id="image-lightbox" class="lightbox" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Image Preview">
    <div class="lightbox__backdrop" data-action="close"></div>
    
    <div class="lightbox__container">
        <!-- Top bar: counter & action buttons -->
        <div class="lightbox__header">
            <span class="lightbox__counter" id="lightbox-counter">1 / 1</span>
            
            <div class="lightbox__toolbar">
                <button type="button" class="lightbox__btn" id="lightbox-zoom-btn" aria-label="Toggle zoom" title="Zoom in / out">
                    <span class="lightbox__icon--zoom-in"><Icon name="zoom-in" size={18} /></span>
                    <span class="lightbox__icon--zoom-out" style="display: none;"><Icon name="zoom-out" size={18} /></span>
                </button>
                <button type="button" class="lightbox__btn" id="lightbox-close-btn" aria-label="Close preview" title="Close (Esc)" data-action="close">
                    <Icon name="x" size={20} />
                </button>
            </div>
        </div>

        <!-- Main stage: previous button, image viewport, next button -->
        <div class="lightbox__stage" id="lightbox-stage">
            <button type="button" class="lightbox__nav lightbox__nav--prev" id="lightbox-prev-btn" aria-label="Previous image">
                <Icon name="chevron-left" size={28} strokeWidth={2.25} />
            </button>

            <div class="lightbox__viewport" id="lightbox-viewport">
                <img id="lightbox-img" class="lightbox__img" src="" alt="" draggable="false" />
            </div>

            <button type="button" class="lightbox__nav lightbox__nav--next" id="lightbox-next-btn" aria-label="Next image">
                <Icon name="chevron-right" size={28} strokeWidth={2.25} />
            </button>
        </div>

        <!-- Bottom bar: caption -->
        <div class="lightbox__footer">
            <p id="lightbox-caption" class="lightbox__caption"></p>
        </div>
    </div>
</div>

<style>
    .lightbox {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 0.25s ease, visibility 0.25s ease;
        touch-action: none;
        user-select: none;
        -webkit-user-select: none;
    }

    .lightbox.is-open {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
    }

    .lightbox__backdrop {
        position: absolute;
        inset: 0;
        background: rgba(9, 10, 10, 0.94);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        cursor: zoom-out;
    }

    .lightbox__container {
        position: relative;
        z-index: 2;
        width: 100vw;
        height: 100vh;
        height: 100dvh;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        pointer-events: none;
    }

    .lightbox__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 24px;
        pointer-events: auto;
    }

    .lightbox__counter {
        font-family: var(--font-mono);
        font-size: 13px;
        letter-spacing: 0.08em;
        color: var(--text-secondary);
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid var(--border);
        padding: 4px 12px;
        border-radius: 999px;
        backdrop-filter: blur(8px);
    }

    .lightbox__toolbar {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .lightbox__btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid var(--border);
        color: var(--text);
        cursor: pointer;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        transition: all 0.2s ease;
    }

    .lightbox__btn:hover {
        background: rgba(151, 196, 89, 0.15);
        border-color: var(--accent);
        color: var(--accent);
        transform: scale(1.06);
    }

    .lightbox__stage {
        position: relative;
        flex: 1;
        min-height: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        padding-inline: 16px;
        pointer-events: auto;
    }

    .lightbox__viewport {
        position: relative;
        max-width: 90vw;
        max-height: calc(100dvh - 150px);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: visible;
        cursor: zoom-in;
    }

    .lightbox.is-zoomed .lightbox__viewport {
        cursor: grab;
    }

    .lightbox.is-zoomed.is-dragging .lightbox__viewport {
        cursor: grabbing;
    }

    .lightbox__img {
        max-width: 90vw;
        max-height: calc(100dvh - 150px);
        width: auto;
        height: auto;
        object-fit: contain;
        border-radius: var(--radius-sm);
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8), 0 0 30px rgba(0, 0, 0, 0.5);
        border: 1px solid rgba(255, 255, 255, 0.08);
        transform-origin: center center;
        transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: transform;
    }

    .lightbox.is-dragging .lightbox__img {
        transition: none;
    }

    .lightbox__nav {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        z-index: 10;
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: rgba(18, 20, 17, 0.85);
        border: 1px solid var(--border);
        color: var(--text);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.5);
        transition: all 0.2s ease;
        pointer-events: auto;
    }

    .lightbox__nav--prev {
        left: 20px;
    }

    .lightbox__nav--next {
        right: 20px;
    }

    .lightbox__nav:hover {
        background: rgba(28, 30, 24, 0.98);
        border-color: var(--accent);
        color: var(--accent);
        transform: translateY(-50%) scale(1.08);
    }

    .lightbox__nav[disabled] {
        opacity: 0.25;
        cursor: not-allowed;
        pointer-events: none;
    }

    .lightbox__footer {
        padding: 14px 24px 20px;
        display: flex;
        justify-content: center;
        pointer-events: auto;
    }

    .lightbox__caption {
        max-width: 65ch;
        margin: 0;
        font-family: var(--font-body);
        font-size: 14px;
        color: var(--text-secondary);
        text-align: center;
        line-height: 1.5;
        background: rgba(18, 20, 17, 0.8);
        border: 1px solid rgba(255, 255, 255, 0.08);
        padding: 6px 16px;
        border-radius: 20px;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
    }

    .lightbox__caption:empty {
        display: none;
    }

    @media (max-width: 768px) {
        .lightbox__header {
            padding: 12px 16px;
        }
        .lightbox__viewport {
            max-width: 96vw;
            max-height: calc(100dvh - 130px);
        }
        .lightbox__img {
            max-width: 96vw;
            max-height: calc(100dvh - 130px);
        }
        .lightbox__nav {
            width: 42px;
            height: 42px;
        }
        .lightbox__nav--prev {
            left: 8px;
        }
        .lightbox__nav--next {
            right: 8px;
        }
        .lightbox__caption {
            font-size: 13px;
            padding: 5px 12px;
            max-width: 90vw;
        }
    }
</style>

<script>
    interface GalleryItem {
        src: string;
        alt: string;
    }

    class LightboxController {
        private modal: HTMLElement | null = null;
        private img: HTMLImageElement | null = null;
        private counter: HTMLElement | null = null;
        private caption: HTMLElement | null = null;
        private prevBtn: HTMLButtonElement | null = null;
        private nextBtn: HTMLButtonElement | null = null;
        private zoomBtn: HTMLButtonElement | null = null;
        private iconZoomIn: HTMLElement | null = null;
        private iconZoomOut: HTMLElement | null = null;

        private items: GalleryItem[] = [];
        private currentIndex = 0;
        private isOpen = false;
        private isZoomed = false;
        private scale = 1;
        private panX = 0;
        private panY = 0;

        // Drag & Touch handling
        private isDragging = false;
        private startX = 0;
        private startY = 0;
        private startPanX = 0;
        private startPanY = 0;
        private initialPinchDist = 0;
        private initialPinchScale = 1;
        private touchStartTime = 0;
        private lastTapTime = 0;

        init() {
            this.modal = document.getElementById("image-lightbox");
            if (!this.modal) return;

            this.img = document.getElementById("lightbox-img") as HTMLImageElement;
            this.counter = document.getElementById("lightbox-counter");
            this.caption = document.getElementById("lightbox-caption");
            this.prevBtn = document.getElementById("lightbox-prev-btn") as HTMLButtonElement;
            this.nextBtn = document.getElementById("lightbox-next-btn") as HTMLButtonElement;
            this.zoomBtn = document.getElementById("lightbox-zoom-btn") as HTMLButtonElement;
            this.iconZoomIn = this.modal.querySelector(".lightbox__icon--zoom-in");
            this.iconZoomOut = this.modal.querySelector(".lightbox__icon--zoom-out");

            this.bindEvents();
            this.collectGalleryItems();
        }

        collectGalleryItems() {
            const shotElements = document.querySelectorAll<HTMLElement>(".shot");
            this.items = [];

            shotElements.forEach((shot, index) => {
                const imgEl = shot.querySelector<HTMLImageElement>("img");
                if (!imgEl) return;

                const item: GalleryItem = {
                    src: imgEl.currentSrc || imgEl.src,
                    alt: imgEl.alt || "",
                };
                this.items.push(item);

                // Make thumbnail interactive
                shot.setAttribute("role", "button");
                shot.setAttribute("tabindex", "0");
                shot.setAttribute("aria-label", `Perbesar gambar: ${item.alt}`);

                shot.onclick = (e) => {
                    e.preventDefault();
                    this.open(index);
                };

                shot.onkeydown = (e) => {
                    if (e.key === "Enter" || e.key === " ") {
                        e.preventDefault();
                        this.open(index);
                    }
                };
            });
        }

        private bindEvents() {
            if (!this.modal) return;

            // Close actions
            this.modal.querySelectorAll('[data-action="close"]').forEach((el) => {
                el.addEventListener("click", () => this.close());
            });

            // Nav buttons
            this.prevBtn?.addEventListener("click", (e) => {
                e.stopPropagation();
                this.prev();
            });

            this.nextBtn?.addEventListener("click", (e) => {
                e.stopPropagation();
                this.next();
            });

            // Zoom toggle button
            this.zoomBtn?.addEventListener("click", (e) => {
                e.stopPropagation();
                this.toggleZoom();
            });

            // Keyboard navigation
            window.addEventListener("keydown", (e) => {
                if (!this.isOpen) return;

                if (e.key === "Escape") {
                    this.close();
                } else if (e.key === "ArrowLeft") {
                    this.prev();
                } else if (e.key === "ArrowRight") {
                    this.next();
                } else if (e.key === "+" || e.key === "=") {
                    this.setZoom(Math.min(this.scale + 0.5, 3));
                } else if (e.key === "-") {
                    this.setZoom(Math.max(this.scale - 0.5, 1));
                } else if (e.key === "0") {
                    this.resetTransform();
                }
            });

            // Image click / drag / double tap
            const viewport = document.getElementById("lightbox-viewport");
            if (viewport && this.img) {
                viewport.addEventListener("click", (e) => {
                    if (this.isDragging) return;
                    this.handleSingleClick(e);
                });

                // Pointer events for panning
                viewport.addEventListener("pointerdown", (e) => this.onPointerDown(e));
                window.addEventListener("pointermove", (e) => this.onPointerMove(e));
                window.addEventListener("pointerup", (e) => this.onPointerUp(e));
                window.addEventListener("pointercancel", (e) => this.onPointerUp(e));

                // Touch events for swipe & pinch-to-zoom
                viewport.addEventListener("touchstart", (e) => this.onTouchStart(e), { passive: false });
                viewport.addEventListener("touchmove", (e) => this.onTouchMove(e), { passive: false });
                viewport.addEventListener("touchend", (e) => this.onTouchEnd(e), { passive: false });
            }
        }

        open(index: number) {
            if (!this.items.length) return;
            this.currentIndex = (index + this.items.length) % this.items.length;
            this.isOpen = true;
            this.modal?.classList.add("is-open");
            document.body.style.overflow = "hidden";

            this.renderItem();
            this.resetTransform();
        }

        close() {
            if (!this.isOpen) return;
            this.isOpen = false;
            this.modal?.classList.remove("is-open", "is-zoomed", "is-dragging");
            document.body.style.overflow = "";
            this.resetTransform();
        }

        prev() {
            if (this.items.length <= 1) return;
            this.currentIndex = (this.currentIndex - 1 + this.items.length) % this.items.length;
            this.renderItem();
            this.resetTransform();
        }

        next() {
            if (this.items.length <= 1) return;
            this.currentIndex = (this.currentIndex + 1) % this.items.length;
            this.renderItem();
            this.resetTransform();
        }

        private renderItem() {
            const item = this.items[this.currentIndex];
            if (!item || !this.img) return;

            this.img.src = item.src;
            this.img.alt = item.alt;

            if (this.counter) {
                this.counter.textContent = `${this.currentIndex + 1} / ${this.items.length}`;
            }

            if (this.caption) {
                this.caption.textContent = item.alt;
            }

            if (this.prevBtn && this.nextBtn) {
                const singleItem = this.items.length <= 1;
                this.prevBtn.style.display = singleItem ? "none" : "";
                this.nextBtn.style.display = singleItem ? "none" : "";
            }
        }

        private toggleZoom(originX?: number, originY?: number) {
            if (this.isZoomed) {
                this.resetTransform();
            } else {
                this.setZoom(2.2, originX, originY);
            }
        }

        private setZoom(scale: number, originX?: number, originY?: number) {
            this.scale = scale;
            this.isZoomed = scale > 1.05;

            if (!this.isZoomed) {
                this.panX = 0;
                this.panY = 0;
                this.modal?.classList.remove("is-zoomed");
            } else {
                this.modal?.classList.add("is-zoomed");
                if (originX !== undefined && originY !== undefined && this.img) {
                    const rect = this.img.getBoundingClientRect();
                    const offsetX = originX - (rect.left + rect.width / 2);
                    const offsetY = originY - (rect.top + rect.height / 2);
                    this.panX = -offsetX * (scale - 1);
                    this.panY = -offsetY * (scale - 1);
                }
            }

            this.updateZoomUI();
            this.applyTransform();
        }

        private resetTransform() {
            this.scale = 1;
            this.panX = 0;
            this.panY = 0;
            this.isZoomed = false;
            this.modal?.classList.remove("is-zoomed", "is-dragging");
            this.updateZoomUI();
            this.applyTransform();
        }

        private updateZoomUI() {
            if (this.iconZoomIn && this.iconZoomOut) {
                this.iconZoomIn.style.display = this.isZoomed ? "none" : "";
                this.iconZoomOut.style.display = this.isZoomed ? "" : "none";
            }
        }

        private applyTransform() {
            if (!this.img) return;
            this.constrainPan();
            this.img.style.transform = `translate3d(${this.panX}px, ${this.panY}px, 0px) scale(${this.scale})`;
        }

        private constrainPan() {
            if (!this.isZoomed || !this.img) {
                this.panX = 0;
                this.panY = 0;
                return;
            }

            const imgW = this.img.clientWidth * this.scale;
            const imgH = this.img.clientHeight * this.scale;
            const stageW = window.innerWidth;
            const stageH = window.innerHeight;

            const maxPanX = Math.max(0, (imgW - stageW) / 2 + 50);
            const maxPanY = Math.max(0, (imgH - stageH) / 2 + 50);

            this.panX = Math.max(-maxPanX, Math.min(maxPanX, this.panX));
            this.panY = Math.max(-maxPanY, Math.min(maxPanY, this.panY));
        }

        private handleSingleClick(e: MouseEvent) {
            const now = Date.now();
            if (now - this.lastTapTime < 300) {
                // Double tap / double click
                this.toggleZoom(e.clientX, e.clientY);
                this.lastTapTime = 0;
            } else {
                this.lastTapTime = now;
                setTimeout(() => {
                    if (this.lastTapTime === now && !this.isDragging) {
                        this.toggleZoom(e.clientX, e.clientY);
                    }
                }, 280);
            }
        }

        // Pointer drag handling
        private onPointerDown(e: PointerEvent) {
            if (!this.isZoomed || e.button !== 0) return;
            this.isDragging = true;
            this.modal?.classList.add("is-dragging");
            this.startX = e.clientX;
            this.startY = e.clientY;
            this.startPanX = this.panX;
            this.startPanY = this.panY;
        }

        private onPointerMove(e: PointerEvent) {
            if (!this.isDragging || !this.isZoomed) return;
            const dx = e.clientX - this.startX;
            const dy = e.clientY - this.startY;
            this.panX = this.startPanX + dx;
            this.panY = this.startPanY + dy;
            this.applyTransform();
        }

        private onPointerUp(_e: PointerEvent) {
            if (this.isDragging) {
                setTimeout(() => {
                    this.isDragging = false;
                    this.modal?.classList.remove("is-dragging");
                }, 50);
            }
        }

        // Mobile Touch Gestures (Swipe to change, pull to dismiss, pinch zoom)
        private onTouchStart(e: TouchEvent) {
            this.touchStartTime = Date.now();

            if (e.touches.length === 2) {
                // Pinch to zoom start
                const t1 = e.touches[0];
                const t2 = e.touches[1];
                this.initialPinchDist = Math.hypot(t2.clientX - t1.clientX, t2.clientY - t1.clientY);
                this.initialPinchScale = this.scale;
                e.preventDefault();
            } else if (e.touches.length === 1) {
                this.startX = e.touches[0].clientX;
                this.startY = e.touches[0].clientY;
                this.startPanX = this.panX;
                this.startPanY = this.panY;
            }
        }

        private onTouchMove(e: TouchEvent) {
            if (e.touches.length === 2) {
                // Pinching
                const t1 = e.touches[0];
                const t2 = e.touches[1];
                const dist = Math.hypot(t2.clientX - t1.clientX, t2.clientY - t1.clientY);
                if (this.initialPinchDist > 0) {
                    const nextScale = Math.min(Math.max(this.initialPinchScale * (dist / this.initialPinchDist), 1), 3.5);
                    this.setZoom(nextScale);
                }
                e.preventDefault();
            } else if (e.touches.length === 1 && this.isZoomed) {
                // Panning while zoomed
                const dx = e.touches[0].clientX - this.startX;
                const dy = e.touches[0].clientY - this.startY;
                this.panX = this.startPanX + dx;
                this.panY = this.startPanY + dy;
                this.applyTransform();
                e.preventDefault();
            }
        }

        private onTouchEnd(e: TouchEvent) {
            if (e.changedTouches.length === 1 && !this.isZoomed) {
                const touch = e.changedTouches[0];
                const diffX = touch.clientX - this.startX;
                const diffY = touch.clientY - this.startY;
                const duration = Date.now() - this.touchStartTime;

                // Swipe detection (quick horizontal flick)
                if (duration < 350 && Math.abs(diffX) > 45 && Math.abs(diffY) < 60) {
                    if (diffX < 0) {
                        this.next();
                    } else {
                        this.prev();
                    }
                }
                // Swipe down to dismiss
                else if (duration < 350 && diffY > 75 && Math.abs(diffX) < 50) {
                    this.close();
                }
            }
            this.initialPinchDist = 0;
        }
    }

    const controller = new LightboxController();

    function initLightbox() {
        controller.init();
    }

    document.addEventListener("astro:page-load", initLightbox);
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initLightbox);
    } else {
        initLightbox();
    }
</script>
