---
interface Props {
    seed?: number;
    levels?: number;
    height?: string;
    opacity?: number;
    class?: string;
}

const {
    seed = 23,
    levels = 13,
    height = "100%",
    opacity = 0.55,
    class: className = "",
} = Astro.props;
---

<div
    class:list={["contour-field", className]}
    data-seed={seed}
    data-levels={levels}
    style={`--cf-height:${height}; --cf-opacity:${opacity};`}
>
    <svg class="contour-field__svg" preserveAspectRatio="xMidYMid slice"></svg>
</div>

<style>
    .contour-field {
        position: absolute;
        inset: 0;
        height: var(--cf-height);
        overflow: hidden;
        pointer-events: none;
    }
    .contour-field__svg {
        width: 100%;
        height: 100%;
        opacity: var(--cf-opacity);
        display: block;
    }
</style>

<script>
    // Generates true vector contour lines (marching squares over a computed
    // elevation field) for every .contour-field on the page. Real <path> data,
    // not a raster filter — scales cleanly at any size.
    function hash(seed: number) {
        let s = seed;
        return () => {
            s = (s * 1103515245 + 12345) & 0x7fffffff;
            return s / 0x7fffffff;
        };
    }

    function heightFn(seed: number) {
        const r = hash(seed);
        const phases = Array.from({ length: 6 }, () => r() * Math.PI * 2);
        return (x: number, y: number) => {
            let v = 0;
            v +=
                Math.sin(x * 0.02 + phases[0]) *
                Math.cos(y * 0.024 + phases[1]);
            v += 0.55 * Math.sin(x * 0.041 + phases[2] + y * 0.017);
            v += 0.5 * Math.cos(y * 0.037 + phases[3] - x * 0.015);
            v += 0.3 * Math.sin((x + y) * 0.026 + phases[4]);
            v += 0.3 * Math.cos((x - y) * 0.031 + phases[5]);
            v += 0.15 * Math.sin(x * 0.07 + y * 0.05);
            return v;
        };
    }

    const stops: [number, string][] = [
        [0, "#04342c"],
        [0.12, "#0f6e56"],
        [0.24, "#173404"],
        [0.36, "#27500a"],
        [0.48, "#3b6d11"],
        [0.6, "#639922"],
        [0.7, "#97c459"],
        [0.8, "#c0dd97"],
        [0.88, "#633806"],
        [0.93, "#854f0b"],
        [0.97, "#ba7517"],
        [1, "#ef9f27"],
    ];

    function hexToRgb(hx: string) {
        hx = hx.replace("#", "");
        return [
            parseInt(hx.substring(0, 2), 16),
            parseInt(hx.substring(2, 4), 16),
            parseInt(hx.substring(4, 6), 16),
        ];
    }

    function colorRamp(t: number) {
        for (let i = 0; i < stops.length - 1; i++) {
            if (t >= stops[i][0] && t <= stops[i + 1][0]) {
                const f = (t - stops[i][0]) / (stops[i + 1][0] - stops[i][0]);
                const [r1, g1, b1] = hexToRgb(stops[i][1]);
                const [r2, g2, b2] = hexToRgb(stops[i + 1][1]);
                const r = Math.round(r1 + (r2 - r1) * f);
                const g = Math.round(g1 + (g2 - g1) * f);
                const b = Math.round(b1 + (b2 - b1) * f);
                return `rgb(${r},${g},${b})`;
            }
        }
        return stops[stops.length - 1][1];
    }

    const caseTable: Record<number, [string, string][]> = {
        1: [["L", "B"]],
        2: [["B", "R"]],
        3: [["L", "R"]],
        4: [["T", "R"]],
        5: [
            ["T", "L"],
            ["B", "R"],
        ],
        6: [["T", "B"]],
        7: [["T", "L"]],
        8: [["T", "L"]],
        9: [["T", "B"]],
        10: [
            ["T", "R"],
            ["B", "L"],
        ],
        11: [["T", "R"]],
        12: [["L", "R"]],
        13: [["B", "R"]],
        14: [["L", "B"]],
    };

    function buildField(container: Element) {
        const svg = container.querySelector("svg") as SVGSVGElement | null;
        if (!svg) return;

        const rect = container.getBoundingClientRect();
        const W = Math.max(rect.width, 320);
        const H = Math.max(rect.height, 240);
        svg.setAttribute("viewBox", `0 0 ${W} ${H}`);

        const seed = Number(container.getAttribute("data-seed")) || 23;
        const nLevels = Number(container.getAttribute("data-levels")) || 13;
        const h = heightFn(seed);

        const nx = Math.round(W / 8.3);
        const ny = Math.round(H / 8.3);
        const dx = W / nx;
        const dy = H / ny;

        const grid: number[][] = [];
        let minV = Infinity;
        let maxV = -Infinity;
        for (let j = 0; j <= ny; j++) {
            const row: number[] = [];
            for (let i = 0; i <= nx; i++) {
                const val = h(i * dx, j * dy);
                row.push(val);
                if (val < minV) minV = val;
                if (val > maxV) maxV = val;
            }
            grid.push(row);
        }

        const margin = (maxV - minV) * 0.06;
        const levels: number[] = [];
        for (let k = 0; k < nLevels; k++) {
            levels.push(
                minV +
                    margin +
                    (maxV - minV - 2 * margin) * (k / (nLevels - 1)),
            );
        }

        function edgePt(
            edge: string,
            x: number,
            y: number,
            vTL: number,
            vTR: number,
            vBR: number,
            vBL: number,
            t: number,
        ): [number, number] {
            if (edge === "T") return [x + ((t - vTL) / (vTR - vTL)) * dx, y];
            if (edge === "R")
                return [x + dx, y + ((t - vTR) / (vBR - vTR)) * dy];
            if (edge === "B")
                return [x + ((t - vBL) / (vBR - vBL)) * dx, y + dy];
            return [x, y + ((t - vTL) / (vBL - vTL)) * dy];
        }

        const frag = document.createDocumentFragment();

        levels.forEach((t, li) => {
            let d = "";
            for (let j = 0; j < ny; j++) {
                for (let i = 0; i < nx; i++) {
                    const vTL = grid[j][i];
                    const vTR = grid[j][i + 1];
                    const vBR = grid[j + 1][i + 1];
                    const vBL = grid[j + 1][i];
                    const idx =
                        (vTL >= t ? 8 : 0) +
                        (vTR >= t ? 4 : 0) +
                        (vBR >= t ? 2 : 0) +
                        (vBL >= t ? 1 : 0);
                    const pairs = caseTable[idx];
                    if (!pairs) continue;
                    const x = i * dx;
                    const y = j * dy;
                    for (const [e1, e2] of pairs) {
                        const p1 = edgePt(e1, x, y, vTL, vTR, vBR, vBL, t);
                        const p2 = edgePt(e2, x, y, vTL, vTR, vBR, vBL, t);
                        d += `M${p1[0].toFixed(1)},${p1[1].toFixed(1)}L${p2[0].toFixed(1)},${p2[1].toFixed(1)} `;
                    }
                }
            }
            const path = document.createElementNS(
                "http://www.w3.org/2000/svg",
                "path",
            );
            path.setAttribute("d", d);
            path.setAttribute("stroke", colorRamp(li / (nLevels - 1)));
            path.setAttribute("stroke-width", li % 4 === 0 ? "1.1" : "0.6");
            path.setAttribute("stroke-opacity", li % 4 === 0 ? "0.85" : "0.5");
            path.setAttribute("fill", "none");
            path.setAttribute("stroke-linecap", "round");
            frag.appendChild(path);
        });

        svg.innerHTML = "";
        svg.appendChild(frag);
    }

    function initAll() {
        document.querySelectorAll(".contour-field").forEach(buildField);
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initAll);
    } else {
        initAll();
    }
</script>
